 "cenas": [
  {
   "id": "oi",
   "fala": "大家好！我是CYRON。今天我来讲讲，我是怎么诞生的。"
  },
  {
   "id": "alianca",
   "fala": "一切都从Kingshot里的一个联盟开始，它叫TOP Best。成员来自巴西、印尼、德国、菲律宾、中国，还有阿拉伯世界。大家在一起，却谁也听不懂谁。"
  },
  {
   "id": "bots",
   "fala": "他们在Discord上建了服务器，试了好多翻译机器人。可每次都一样：每条消息都要输一次指令，聊天乱成一团。"
  },
  {
   "id": "erros",
   "fala": "还经常翻错！有人用葡萄牙语问：有人去集结吗？结果德国人收到的是：有人参加游行了吗？还有，打开宝箱，变成了打开公交车！",
   "pausa": 0.6
  },
  {
   "id": "tiago",
   "fala": "就在这时，联盟的一位R4，Tiago，决定自己想办法。"
  },
  {
   "id": "portal",
   "fala": "首先，Tiago给联盟做了一个专属网站，聊天自动翻译，活动时间也会换成每个人的时区。"
  },
  {
   "id": "bot",
   "fala": "后来，Discord上有了机器人，能自动翻译聊天，还会发玫瑰花的动图！"
  },
  {
   "id": "espelho",
   "fala": "但Tiago还想要更多：让每个人都用自己的语言聊天，就像大家说的是同一种语言。于是，镜像聊天诞生了。每种语言一个频道，所有频道都是同一段对话。"
  },
  {
   "id": "nome",
   "fala": "就在那一天，我有了自己的名字：CYRON！",
   "pausa": 0.6
  },
  {
   "id": "mundo",
   "fala": "效果太好了，其他联盟也纷纷来问。于是我不再只属于TOP，变成了任何服务器都能安装的机器人。"
  },
  {
   "id": "hoje",
   "fala": "现在我会说二十二种语言，能传贴纸、表情、带提醒的活动，而且每天都在学习。"
  },
  {
   "id": "fim",
   "fala": "这就是我的故事。如果你的联盟也说很多种语言，就来找我吧！链接在简介里。下一集见！"
  }
